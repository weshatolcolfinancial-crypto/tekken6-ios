{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ios",
      "displayName": "iOS arm64 (Release)",
      "description": "Cross-compile Tekken 6 for iOS / iPadOS arm64 with Xcode toolchain",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ios",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
        "CMAKE_BUILD_WITH_INSTALL_RPATH": "ON",
        "REXGLUE_USE_VULKAN": "ON",
        "REXGLUE_USE_D3D12": "OFF",
        "REXGLUE_ENABLE_TRACY": "OFF",
        "REXGLUE_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ios",
      "configurePreset": "ios",
      "configuration": "Release"
    }
  ]
}
